{
  "name": "trainote",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "pnpm build && vite preview",
    "typecheck": "tsc -b",
    "lint": "oxlint --type-aware && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "cf-typegen": "wrangler types",
    "tokens": "node scripts/tokens.ts",
    "design:check": "node scripts/design-check.ts",
    "tokens:check": "pnpm tokens && test -z \"$(git status --porcelain -- design/src/tokens.css)\"",
    "storybook": "storybook dev --port 6006 --host 0.0.0.0 --no-open --ci",
    "storybook:build": "storybook build --output-dir dist-storybook",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit generate && test -z \"$(git status --porcelain -- migrations)\"",
    "db:migrate:local": "wrangler d1 migrations apply trainote --local",
    "db:migrate:remote": "wrangler d1 migrations apply trainote --remote"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@block65/webcrypto-web-push": "^2.0.0",
    "drizzle-orm": "^0.45.4",
    "framework7-icons": "5.0.5",
    "hono": "^4.13.14",
    "jose": "^6.2.14",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.66.0",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/react-vite": "^10.6.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "prettier": "^3.9.10",
    "storybook": "^10.6.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  }
}
